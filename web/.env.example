# Copy to .env for local development, and set the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.
#
# NO VITE_ PREFIX. TanStack Start inlines VITE_-prefixed values into browser code,
# which would hand the Modal credential to every visitor. These three are read
# only inside the server function in src/lib/edit.ts.

# The deployed Modal endpoint, printed by `modal deploy`.
IMAGE_EDITOR_API_URL=https://<workspace>--image-editor-api.modal.run

# A Modal PROXY token (Modal dashboard -> Settings -> Proxy Tokens, or
# `modal workspace proxy-tokens create`). Deliberately NOT called
# MODAL_TOKEN_ID/MODAL_TOKEN_SECRET: those are the Modal CLI's own auth variables,
# and these are wk-/ws- proxy credentials used only for web-function auth. Sharing
# the name breaks the CLI with "Token ID is malformed".
MODAL_PROXY_TOKEN_ID=wk-...
MODAL_PROXY_TOKEN_SECRET=ws-...
